# ---------- LLM Providers ----------
# Claude (Anthropic) —— 主力视觉+中文讲解
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_VISION=claude-sonnet-4-6
ANTHROPIC_MODEL_ESCALATE=claude-opus-4-7

# Codex (GPT-5.4) —— 经由本地 Codex CLI 子进程调用
# 请确保本机 `codex` 命令可用、已登录/配置好账号
CODEX_CLI_PATH=codex
CODEX_DEFAULT_MODEL=gpt-5.4
# Codex 单次调用超时（毫秒）
CODEX_TIMEOUT_MS=120000

# ---------- WeChat · via OpenClaw Plugin ----------
# OpenClaw 插件回调本服务的共享密钥（用于简易鉴权）
OPENCLAW_WEBHOOK_SECRET=change-me
# 本服务回推消息给 OpenClaw 插件的地址
OPENCLAW_PUSHBACK_URL=http://127.0.0.1:9000/pushback

# ---------- HTTP ----------
PORT=3100
# 局域网访问结果页的基准 URL（会写入回推微信的短链）
PUBLIC_BASE_URL=http://192.168.1.100:3100

# ---------- Storage ----------
SQLITE_PATH=./data/db/homework.db
UPLOAD_DIR=./uploads

# ---------- Feature Flags ----------
# V1 学科范围（数学优先）
ENABLED_SUBJECTS=math
# 本地模型开关（V1 关闭，全部走在线 API）
LOCAL_VLM_ENABLED=false

# ---------- Observability ----------
LOG_LEVEL=info
