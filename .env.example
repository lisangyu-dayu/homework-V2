# ---------- LLM · 订阅模式（非 API Key）----------
# 本服务不持有任何 API Key。默认 Codex CLI 必需，Claude CLI 作为可选兜底：
#   - Codex ：通过 Codex CLI（已 `codex login` 的本机登录态）
#   - Claude：通过 Claude Code CLI（已 `claude login` 的本机登录态，可选）
#
# 换言之，起服务前请先在本机完成一次：
#   $ codex  login
# 若要启用 Claude 兜底，再执行：
#   $ claude login
# 凭据分别落在 ~/.codex 与 ~/.claude，本服务只读复用。

# 两侧统一走 CLI 子进程池，避免订阅凭据管理差异

# Claude Code CLI
REQUIRE_CLAUDE_CLI=false
CLAUDE_CLI_PATH=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_POOL_SIZE=4
CLAUDE_TIMEOUT_MS=120000

# Codex CLI
# 当前机器安装在 Conda 虚拟环境 homework-v2：
#   /home/lsy/miniconda3/envs/homework-v2/bin/codex
# 如果服务进程不会先 `conda activate homework-v2`，请使用该绝对路径。
CODEX_CLI_PATH=/home/lsy/miniconda3/envs/homework-v2/bin/codex
CODEX_DEFAULT_MODEL=gpt-5.4
CODEX_POOL_SIZE=3
CODEX_TIMEOUT_MS=120000
# oneshot：每次请求启动 `codex exec`；hot：文本任务走常驻 `codex mcp-server` 池，图片任务自动回退 oneshot
CODEX_POOL_MODE=oneshot

# SymPy Python runner
SYMPY_PYTHON_BIN=.venv/bin/python
# 若订阅凭据不在默认路径，可覆盖（可选）：
# CLAUDE_CONFIG_DIR=/home/<you>/.claude
# CODEX_HOME=/home/<you>/.codex

# ---------- WeChat · via OpenClaw Plugin ----------
OPENCLAW_WEBHOOK_SECRET=change-me
OPENCLAW_PUSHBACK_URL=http://127.0.0.1:9000/pushback

# ---------- HTTP ----------
PORT=3100
# 局域网访问结果页的基准 URL（会写入回推微信的短链）
PUBLIC_BASE_URL=http://192.168.1.100:3100

# ---------- Auth ----------
# 家长短链签名盐（用于生成 parent_token 的签名短链）
PARENT_LINK_SIGNING_SECRET=please-change-this-32-chars-min
# 短链有效窗口（分钟）；窗口外的链接一律拒绝。cookie 一旦下发走独立 30 天生命周期。
SHORT_LINK_TTL_MINUTES=15
# Cookie 名与生命周期（默认 30 天）
PARENT_COOKIE_NAME=hw_parent
PARENT_COOKIE_MAX_AGE_DAYS=30
# 调试页 Basic Auth
ADMIN_USER=admin
ADMIN_PASS=change-me

# ---------- Storage ----------
SQLITE_PATH=./data/db/homework.db
UPLOAD_DIR=./uploads

# ---------- Feature Flags ----------
ENABLED_SUBJECTS=math
LOCAL_VLM_ENABLED=false

# ---------- Observability ----------
LOG_LEVEL=info
